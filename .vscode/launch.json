{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug SQLite",
      "type": "lldb",
      "request": "launch",

      "cargo": {
        "args": [
          "build"
        ],
        "cwd": "${workspaceFolder}",
        "problemMatcher": "$rustc"
      },

      "args": [
        "${workspaceFolder}/companies.db",
        "SELECT id, name FROM companies WHERE country = 'eritrea';"
      ],

      "cwd": "${workspaceFolder}",
      "sourceLanguages": [
        "rust"
      ],
      "terminal": "integrated"
    }
  ]
}